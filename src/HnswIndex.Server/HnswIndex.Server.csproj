<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.0.2</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Radiant" Version="0.1.2" />
    <PackageReference Include="SerializationHelper" Version="2.1.0" />
    <PackageReference Include="SyslogLogging" Version="2.3.1" />
    <PackageReference Include="Watson" Version="7.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HnswIndex\HnswIndex.csproj" />
    <ProjectReference Include="..\HnswIndex.RamStorage\HnswIndex.RamStorage.csproj" />
    <ProjectReference Include="..\HnswIndex.SqliteStorage\HnswIndex.SqliteStorage.csproj" />
    <ProjectReference Include="..\HnswIndex.PostgresqlStorage\HnswIndex.PostgresqlStorage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="*.bat" CopyToOutputDirectory="Always" />
    <None Include="*.sh" CopyToOutputDirectory="Always" />
    <None Include="Dockerfile" CopyToOutputDirectory="Always" />
    <None Include="*.json" CopyToOutputDirectory="Always" />
    <None Update="assets\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="assets\logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="assets\favicon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
