<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>2.0.1</Version>
		<IsPackable>true</IsPackable>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>HnswIndex.PostgresqlStorage.xml</DocumentationFile>
		<Title>PostgreSQL storage implementation for HnswIndex</Title>
		<Authors>Joel Christner</Authors>
		<Description>PostgreSQL storage implementation for HnswIndex</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/HnswIndex</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/HnswIndex</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>hnsw;postgresql;postgres;vector;embedding;embeddings</PackageTags>
		<PackageReleaseNotes>Initial PostgreSQL storage provider release</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageId>HnswLite.PostgresqlStorage</PackageId>
	</PropertyGroup>

	<ItemGroup Condition="Exists('..\..\assets\logo.png')">
		<None Include="..\..\assets\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\LICENSE.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql" Version="9.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\HnswIndex\HnswIndex.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="postgresql-schema.sql">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>contentFiles/any/any/</PackagePath>
		</Content>
	</ItemGroup>

</Project>
