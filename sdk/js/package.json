{
  "name": "hnswlite-sdk",
  "version": "2.0.0",
  "description": "JavaScript/TypeScript SDK for the HnswLite REST API",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts"
  },
  "keywords": [
    "hnsw",
    "vector",
    "search",
    "sdk"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
