              "otel_scope_name": true,
              "otel_scope_version": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "type": "table",
      "title": "Reload stages",
      "description": "",
