{
  "uid": "hnswlite-index",
  "title": "HnswLite / Index Operations",
  "description": "HNSW graph operations from the HnswLite library: rate and outcome, latency, per-stage breakdown (including time queued for the index write lock), lock contention, and vector throughput.",
  "tags": [
    "hnswlite",
    "index"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "hnswlite"
      ],
      "targetBlank": false,
      "title": "HnswLite dashboards",
      "type": "dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "operation",
        "label": "Operation",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hnswlite_index_stage_duration_seconds_count, hnswlite_operation)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(hnswlite_index_stage_duration_seconds_count, hnswlite_operation)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Operations",
      "id": 1,
      "collapsed": false,
