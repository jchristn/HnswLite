{
  "uid": "hnswlite-storage",
  "title": "HnswLite / Storage & Integrations",
  "description": "Outbound storage integrations (PostgreSQL via Npgsql, SQLite): call rate and errors by provider and operation, per-operation latency, transactions, and the PostgreSQL connection pool.",
  "tags": [
    "hnswlite",
    "storage",
    "integrations"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "hnswlite"
      ],
      "targetBlank": false,
      "title": "HnswLite dashboards",
      "type": "dashboards"
