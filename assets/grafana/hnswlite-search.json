        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(hnswlite_server_operations_total{hnswlite_operation=\"search\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
